# =============================================================================
# .env.example — environment variable template
# Copy this file to ".env" and fill in your real values.
# .env is gitignored — never commit your real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED (for the default project config)
# -----------------------------------------------------------------------------
# The default config in config/setup.json uses Anthropic for all three agents.
# A single key authorizes calls from all three agents.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — only needed if you swap an agent's provider in config/setup.json
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# -----------------------------------------------------------------------------
# OPTIONAL — web search fallback
# DuckDuckGo is the default and needs no key.
# Set this only if you switch the search provider to Tavily.
# -----------------------------------------------------------------------------
# TAVILY_API_KEY=your-tavily-api-key-here
