{
  "version": "1.00",
  "level": "INFO",
  "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
  "datefmt": "%Y-%m-%dT%H:%M:%S",
  "directory": "results/logs/",
  "rotation": {
    "max_files": 20,
    "max_lines_per_file": 500
  },
  "cost_log": {
    "path": "results/cost_log.jsonl",
    "format": "jsonl"
  },
  "console": {
    "enabled": true,
    "level": "INFO"
  }
}
